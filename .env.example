# Backend
APP_ADDR=:8080
DATABASE_URL=postgres://shop:shop@localhost:5433/shop?sslmode=disable
# Telegram notifications about new orders (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# docker-compose Postgres
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# Admin account bootstrap for `go run ./cmd/admin create -email ...`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production: COOKIE_SECURE=true and TRUST_PROXY=true behind Caddy
UPLOAD_DIR=uploads
COOKIE_SECURE=false
TRUST_PROXY=false
