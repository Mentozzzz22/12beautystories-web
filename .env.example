# Backend
APP_ADDR=:8080
DATABASE_URL=postgres://shop:shop@localhost:5433/shop?sslmode=disable
# Telegram notifications about new orders (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# docker-compose Postgres
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop

# Admin account bootstrap for `go run ./cmd/admin create -email ...`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Production: COOKIE_SECURE=true and TRUST_PROXY=true behind Caddy
UPLOAD_DIR=uploads
COOKIE_SECURE=false
TRUST_PROXY=false

# Frontend build served by the Go server (production image sets it to /app/web)
STATIC_DIR=
# Public origin for canonical links, Open Graph and sitemap
PUBLIC_URL=http://localhost:8080

# Production (docker-compose.prod.yml): domain for Caddy HTTPS
DOMAIN=12-beautystories.com
